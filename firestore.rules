// ===================================================================
// Firestore Security Rules — krujamesoncom-website
//
// ระบบคะแนนและ audit ใช้ Firebase Auth + บทบาทครู; ระบบ legacy อื่นยังต้องย้ายสิทธิ์
//
// คะแนนและ audit: Firebase Auth + teacherProfiles/custom claims เป็นขอบเขตสิทธิ์
// เกมส่ง progress/learningEvidence; ครูนำเข้าหลักฐานเข้าสมุดคะแนน
// App Check เสริมการตรวจแอป ไม่ทดแทนสิทธิ์ผู้ใช้
// collection legacy อื่นยังมีสิทธิ์กว้างและต้องย้ายแยกต่างหาก
// ===================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isMap() {
      return request.resource.data is map;
    }
    // จำกัดจำนวน field ต่อ document (กัน payload ระเบิด)
    function fieldsUnder(n) {
      return request.resource.data.keys().size() < n;
    }
    // string สั้นพอ (กัน storage abuse)
    function strOk(v, maxLen) {
      return !(v in request.resource.data)
        || request.resource.data[v] == null
        || (request.resource.data[v] is string && request.resource.data[v].size() <= maxLen);
    }
    // เขียนที่ผ่านเกณฑ์พื้นฐาน: เป็น map + จำนวน field ไม่เกิน
    function baseWrite(maxFields) {
      return isMap() && fieldsUnder(maxFields);
    }
    function isAcademicStudentId(id) {
      return id is string
        && id.size() > 0
        && id != 'admin_teacher_account'
        && !id.matches('^external_visitor_.*');
    }
    function isTeacher() {
      return request.auth != null
        && (
          (('role' in request.auth.token) && (request.auth.token.role == 'admin' || request.auth.token.role == 'teacher'))
          || (
            exists(/databases/$(database)/documents/teacherProfiles/$(request.auth.uid))
            && get(/databases/$(database)/documents/teacherProfiles/$(request.auth.uid)).data.active == true
            && (
              get(/databases/$(database)/documents/teacherProfiles/$(request.auth.uid)).data.role == 'admin'
              || get(/databases/$(database)/documents/teacherProfiles/$(request.auth.uid)).data.role == 'teacher'
            )
          )
        );
    }

    // ====== Teacher identity and audit ======
    match /teacherProfiles/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isTeacher());
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    match /teacherAuditLogs/{id} {
      // Audit snapshots can contain student marks and must share their access boundary.
      allow read: if isTeacher();
      allow create: if isTeacher() && baseWrite(20)
                    && strOk('actor', 300)
                    && strOk('action', 300)
                    && strOk('entityType', 100)
                    && strOk('entityId', 300)
                    && strOk('detail', 5000);
      allow update, delete: if false;
    }

    // ====== Students (รายชื่อ) ======
    match /students/{studentId} {
      allow read: if true;
      allow write: if isAcademicStudentId(studentId)
                   && baseWrite(20)
                   && strOk('name', 200)
                   && strOk('classroom', 20)
                   && strOk('studentNumber', 10);
    }

    // ====== Progress (ความก้าวหน้า + XP + streak + bonus) ======
    match /progress/{studentId} {
      allow read: if true;
      // progress มี nested arrays/maps เยอะ — จำกัดจำนวน top-level field
      allow write: if isAcademicStudentId(studentId) && baseWrite(40);
    }

    // ====== Grades (K/P/A + ทักษะอาชีพ) ======
    match /grades/{docId} {
      allow read: if isTeacher();
      allow create, update: if isTeacher() && baseWrite(30);
      allow delete: if false;
    }

    // ====== Grade closure snapshots and reopen history ======
    match /gradeClosures/{docId} {
      allow read: if isTeacher();
      allow create, update: if isTeacher() && baseWrite(20)
                    && strOk('classroom', 20)
                    && strOk('subject', 50)
                    && strOk('policyVersion', 100);
      allow delete: if false;
    }

    // ====== Primary Technology Outcome 5 Assessments ======
    match /primaryCompetencyAssessments/{recordId} {
      allow read: if true;
      allow write: if baseWrite(30)
                   && strOk('planId', 100)
                   && strOk('classroom', 20)
                   && strOk('studentCode', 100)
                   && strOk('studentName', 300)
                   && strOk('note', 3000);
    }

    // ====== Post-teaching lesson records ======
    match /lessonRecords/{recordId} {
      allow read: if true;
      allow write: if baseWrite(35)
                   && strOk('classroom', 20)
                   && strOk('courseName', 300)
                   && strOk('teacherName', 300)
                   && strOk('teachingDate', 20)
                   && strOk('strengths', 5000)
                   && strOk('problems', 5000)
                   && strOk('causes', 5000)
                   && strOk('improvements', 5000)
                   && strOk('nextAction', 5000);
    }

    // ====== Teaching sessions and unified learning evidence ======
    match /teachingSessions/{sessionId} {
      allow read: if true;
      allow write: if baseWrite(30)
                   && strOk('classroom', 20)
                   && strOk('lessonTitle', 500)
                   && strOk('plannedDate', 20)
                   && strOk('teachingDate', 20)
                   && strOk('note', 3000)
                   && strOk('updatedBy', 300);
    }

    match /learningEvidence/{evidenceId} {
      allow read: if true;
      allow create, update: if isAcademicStudentId(request.resource.data.studentId)
                   && baseWrite(30)
                   && strOk('studentName', 300)
                   && strOk('classroom', 20)
                   && strOk('title', 500)
                   && strOk('detail', 3000);
      allow delete: if isTeacher() || resource.data.classroom is string;
    }

    // ====== Student assessments and general post-lesson records ======
    match /studentAssessments/{recordId} {
      allow read: if isTeacher();
      allow create, update: if isTeacher() && baseWrite(25)
                   && strOk('classroom', 20)
                   && strOk('academicYear', 10)
                   && strOk('term', 20)
                   && strOk('kind', 50)
                   && strOk('contextKey', 120)
                   && strOk('updatedBy', 300);
      allow delete: if false;
    }

    // ====== Announcements ======
    match /announcements/{id} {
      allow read: if true;
      allow write: if baseWrite(20) && strOk('title', 300) && strOk('body', 5000);
    }

    // ====== Calendar Events ======
    match /events/{id} {
      allow read: if true;
      allow write: if baseWrite(20) && strOk('title', 300);
    }

    // ====== Custom Courses (Course Builder) ======
    match /courses/{id} {
      allow read: if true;
      allow write: if baseWrite(50);
    }

    match /courseVersions/{id} {
      allow read: if true;
      allow write: if baseWrite(15);
    }

    match /questionBank/{id} {
      allow read: if true;
      allow create, update: if baseWrite(30)
                   && strOk('classroom', 20)
                   && strOk('indicatorCode', 100)
                   && strOk('question', 3000)
                   && strOk('explanation', 5000);
      allow delete: if isTeacher() || resource.data.classroom is string;
    }

    // ====== Homework (งานที่ครูสั่ง + งานที่นักเรียนส่ง) ======
    match /homeworkAssignments/{id} {
      allow read: if true;
      allow write: if baseWrite(30)
                   && strOk('title', 500)
                   && strOk('description', 10000)
                   && strOk('classroom', 20);
    }

    match /homeworkSubmissions/{id} {
      allow read: if true;
      allow write: if isAcademicStudentId(request.resource.data.studentId)
                   && baseWrite(30)
                   && strOk('studentName', 300)
                   && strOk('classroom', 20)
                   && strOk('contentUrl', 3000)
                   && strOk('comment', 5000)
                   && strOk('feedback', 5000);
    }

    // ====== Schedule / courseAccess / unitLocks ======
    match /schedule/{id} {
      allow read: if true;
      allow write: if baseWrite(30);
    }

    // ====== Custom Slides (NotebookLM) ======
    match /custom_slides/{id} {
      allow read: if true;
      allow write: if baseWrite(60);
    }

    // ====== Site Settings (รหัสเข้าระบบ ฯลฯ) ======
    match /settings/{id} {
      allow read: if true;
      allow write: if baseWrite(15) && strOk('accessCode', 100);
    }

    // ====== Manual Attendance (เช็คชื่อ Quick) ======
    match /attendance/{id} {
      allow read: if true;
      allow write: if baseWrite(10);
    }

    // ====== Daily Questions (คำถามประจำวัน) ======
    match /dailyQuestions/{id} {
      allow read: if true;
      allow write: if baseWrite(10) && strOk('question', 1000);
    }

    // ====== Satisfaction Surveys (แบบสอบถามความพึงพอใจ) ======
    match /surveys/{studentId} {
      allow read: if true;
      allow write: if baseWrite(10);
    }

    // ====== External website trial visitors ======
    // ผู้ทดลองกรอกเฉพาะชื่อ และไม่ถูกนำไปปนกับ students/progress/grades
    match /externalVisitors/{visitorId} {
      allow read, delete: if isTeacher();
      allow create, update: if baseWrite(10)
                   && strOk('id', 200)
                   && strOk('displayName', 100)
                   && strOk('source', 50)
                   && request.resource.data.id == visitorId
                   && request.resource.data.source == 'website-trial';
    }

    // เปิดเฉพาะยอดรวมที่ไม่ระบุตัวบุคคลให้หน้า Admin แบบ legacy ดูสถิติได้
    match /externalVisitorStats/{statId} {
      allow read: if true;
      allow create, update: if baseWrite(8)
                   && strOk('source', 50)
                   && request.resource.data.source == 'website-trial';
      allow delete: if isTeacher();
    }

    // ====== Live Quiz Rooms ======
    match /liveQuizzes/{code} {
      allow read: if true;
      allow write: if baseWrite(20);
    }

    // ====== Computing Tycoon multiplayer rooms ======
    match /tycoonRooms/{code} {
      allow read: if true;
      allow create, update: if baseWrite(20)
                   && strOk('code', 6)
                   && strOk('name', 100)
                   && strOk('passwordHash', 100)
                   && strOk('hostId', 300);
      allow delete: if true;
    }

    // ====== Virtual 3D Classroom ======
    match /virtualWorlds/{roomId} {
      allow read: if true;
      allow create, update: if baseWrite(10);
      allow delete: if true;
    }

    match /virtualPlayers/{playerId} {
      allow read: if true;
      allow create, update: if baseWrite(20)
                   && strOk('name', 300)
                   && strOk('classroom', 20)
                   && strOk('roomId', 100);
      allow delete: if true;
    }

    // สถานะห้องที่ครูควบคุม: ล็อกการเดิน/สร้าง, สไลด์ร่วม, รหัสห้อง และการอนุมัติ
    match /virtualRooms/{roomId} {
      allow read: if true;
      allow create, update: if baseWrite(40)
                   && strOk('roomId', 100)
                   && strOk('classroom', 20)
                   && strOk('accessCodeHash', 100)
                   && strOk('activeGamePath', 300)
                   && strOk('activeGameTitle', 300)
                   && strOk('updatedBy', 300);
      allow delete: if true;
    }

    // เหตุการณ์หลักฐานในห้อง 3D ใช้ document id คงที่เพื่อไม่บันทึกซ้ำ
    match /virtualActivityEvents/{eventId} {
      allow read: if true;
      allow create, update: if baseWrite(20)
                   && strOk('eventId', 200)
                   && strOk('roomId', 100)
                   && strOk('playerId', 300)
                   && strOk('playerName', 300)
                   && strOk('classroom', 20)
                   && strOk('detail', 1000);
      allow delete: if true;
    }

    // Default deny for any other path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
