// ===================================================================
// Firestore Security Rules — krujamesoncom-website
//
// สำหรับระบบเรียนออนไลน์ Kru James (ไม่มี Firebase Auth ล็อกอินในระบบหลังบ้าน)
// การเข้าถึงความปลอดภัยในการบันทึกจะใช้การยืนยันตัวตนและการเข้าถึงระดับแอปพลิเคชัน
// ===================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ====== Students ======
    match /students/{studentId} {
      allow read, write: if true;
    }

    // ====== Progress ======
    match /progress/{studentId} {
      allow read, write: if true;
    }

    // ====== Grades (K/P/A) ======
    match /grades/{docId} {
      allow read, write: if true;
    }

    // ====== Announcements ======
    match /announcements/{id} {
      allow read, write: if true;
    }

    // ====== Calendar Events ======
    match /events/{id} {
      allow read, write: if true;
    }

    // ====== Custom Courses (Course Builder) ======
    match /courses/{id} {
      allow read, write: if true;
    }

    // ====== Schedule (ตารางสอน) ======
    match /schedule/{id} {
      allow read, write: if true;
    }

    // ====== Custom Slides (NotebookLM) ======
    match /custom_slides/{id} {
      allow read, write: if true;
    }

    // Default deny for any other path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
