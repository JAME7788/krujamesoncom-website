rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isTeacher() {
      return request.auth != null
        && (request.auth.token.role == 'admin' || request.auth.token.role == 'teacher');
    }
    function ownsStudent(studentId) {
      return request.auth != null
        && request.auth.token.role == 'student'
        && request.auth.token.studentId == studentId;
    }

    match /homework/{studentId}/{allPaths=**} {
      allow read: if isTeacher() || ownsStudent(studentId);
      allow write: if ownsStudent(studentId)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }

    match /assignments/{studentId}/{allPaths=**} {
      allow read: if isTeacher() || ownsStudent(studentId);
      allow write: if ownsStudent(studentId)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }
  }
}
