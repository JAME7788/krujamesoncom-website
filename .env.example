# Firebase Configuration (แยกจากเว็บโรงเรียน)
# หมายเหตุ: ค่าเหล่านี้ไม่ใช่ความลับ — ฝังใน bundle ของ Firebase web app อยู่แล้ว
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# App Check (reCAPTCHA v3) — ★ ชั้นป้องกันหลักไม่ให้คนยิง Firestore ตรงๆ
# เอา site key จาก Firebase Console -> App Check -> ลงทะเบียนเว็บด้วย reCAPTCHA v3
# ตั้งค่านี้แล้วต้องไปกด "Enforce" ที่ Firestore ใน Console ด้วย
VITE_RECAPTCHA_SITE_KEY=

# Admin login (ครู) — เปลี่ยนรหัสได้ที่นี่โดยไม่ต้องแก้ซอร์ส
# ค่านี้ฝังใน bundle เสมอ (ตรวจฝั่ง browser) — เป็นแค่ "กันคนทั่วไป"
# ความปลอดภัยจริงของข้อมูลอยู่ที่ App Check + Firestore Rules
VITE_ADMIN_USER=jameskmd
VITE_ADMIN_PASS=change_me_please
